# Claude Code extra keys: default Termux rows unchanged, one Claude row added on top
extra-keys = [ \
 [{macro: "ALT m", display: "mode"}, {macro: "ALT s", display: "sendf"}, {macro: "CTRL j", display: "newln"}, {macro: "ALT t", display: "think"}, {macro: "CTRL o", display: "transcr"}, {macro: "CTRL t", display: "todos"}, {macro: "ALT o", display: "fast"}], \
 ['ESC','/','-','HOME','UP','END','PGUP'], \
 ['TAB','CTRL','ALT','LEFT','DOWN','RIGHT','PGDN'] \
]
